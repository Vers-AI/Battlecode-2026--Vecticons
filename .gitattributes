# Normalize line endings: text files are stored as LF in the repo.
* text=auto

# Ensure these are always treated as text
*.py text
*.md text
*.toml text
*.json text
*.rs text
*.cpp text
*.h text
*.ml text
*.mli text
*.wat text
*.pyi text
*.txt text
*.cmake text

# Windows scripts keep CRLF
*.bat text eol=crlf

# Binary files — never normalize
*.map26a binary
*.wasm binary
*.repl26a binary